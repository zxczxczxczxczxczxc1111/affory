diff --git a/route/rule/rule_item_process_tree.go b/route/rule/rule_item_process_tree.go
new file mode 100644
index 0000000..ba9121d
--- /dev/null
+++ b/route/rule/rule_item_process_tree.go
@@ -0,0 +1,42 @@
+package rule
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	"strings"
+)
+
+type ProcessPathTreeItem struct {
+	paths       map[string]bool
+	roots       map[string]bool
+	description string
+}
+
+func NewProcessPathTreeItem(paths []string, roots ...string) *ProcessPathTreeItem {
+	r := &ProcessPathTreeItem{paths: make(map[string]bool), roots: make(map[string]bool), description: "process_path_tree=" + strings.Join(paths, ",")}
+	for _, path := range paths {
+		r.paths[strings.ToLower(path)] = true
+	}
+	for _, path := range roots {
+		r.roots[strings.ToLower(path)] = true
+	}
+	return r
+}
+
+func (r *ProcessPathTreeItem) Match(metadata *adapter.InboundContext) bool {
+	if metadata.ProcessInfo == nil {
+		return false
+	}
+	for _, path := range metadata.ProcessInfo.ProcessFamilyPaths {
+		if r.paths[strings.ToLower(path)] {
+			return true
+		}
+		// Paths are ordered from this process towards its launchers. Stop at
+		// the nearest configured launcher, independent of rule order.
+		if r.roots[strings.ToLower(path)] {
+			return false
+		}
+	}
+	return false
+}
+
+func (r *ProcessPathTreeItem) String() string { return r.description }
diff --git a/route/rule/rule_item_process_tree_test.go b/route/rule/rule_item_process_tree_test.go
