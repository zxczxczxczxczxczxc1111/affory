@@ -0,0 +1,81 @@
+package rule
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"testing"
+)
+
+func TestAfforyProcessFamilyMatchesAncestryNotExecutableName(t *testing.T) {
+	r := NewProcessPathTreeItem([]string{`C:\Steam\steam.exe`})
+	inside := &adapter.InboundContext{ProcessInfo: &adapter.ConnectionOwner{
+		ProcessID: 20, ProcessPath: `C:\helper.exe`, ProcessFamilyPaths: []string{`C:\helper.exe`, `c:\steam\STEAM.exe`},
+	}}
+	outside := &adapter.InboundContext{ProcessInfo: &adapter.ConnectionOwner{
+		ProcessID: 30, ProcessPath: `C:\helper.exe`, ProcessFamilyPaths: []string{`C:\helper.exe`, `C:\explorer.exe`},
+	}}
+	if !r.Match(inside) || r.Match(outside) || r.Match(&adapter.InboundContext{}) {
+		t.Fatal("process family classification is incorrect")
+	}
+}
+
+func TestAfforyProcessFamilyOptionIsAccepted(t *testing.T) {
+	var rule option.Rule
+	err := rule.UnmarshalJSONContext(context.Background(), []byte(`{"process_path_tree":["C:\\Steam\\steam.exe"],"outbound":"direct"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rule.DefaultOptions.ProcessPathTree) != 1 {
+		t.Fatal("family matcher was discarded")
+	}
+}
+
+func TestAfforyNearestConfiguredLauncherWinsRegardlessOfRuleOrder(t *testing.T) {
+	outer, inner := `C:\Outer.exe`, `C:\Inner.exe`
+	far := NewProcessPathTreeItem([]string{outer}, outer, inner)
+	near := NewProcessPathTreeItem([]string{inner}, outer, inner)
+	metadata := &adapter.InboundContext{ProcessInfo: &adapter.ConnectionOwner{
+		ProcessPath: `C:\App.exe`, ProcessFamilyPaths: []string{`C:\App.exe`, `c:\INNER.exe`, outer},
+	}}
+	for _, rules := range [][]*ProcessPathTreeItem{{far, near}, {near, far}} {
+		var winner *ProcessPathTreeItem
+		for _, r := range rules {
+			if r.Match(metadata) {
+				winner = r
+				break
+			}
+		}
+		if winner != near {
+			t.Fatal("nearest configured launcher did not win")
+		}
+	}
+	metadata.ProcessInfo.ProcessFamilyPaths = []string{`C:\Other.exe`, outer}
+	if !far.Match(metadata) || near.Match(metadata) {
+		t.Fatal("unrelated branch lost outer rule")
+	}
+	metadata.ProcessInfo.ProcessFamilyPaths = []string{`C:\Other.exe`}
+	if far.Match(metadata) || near.Match(metadata) {
+		t.Fatal("unknown family was guessed")
+	}
+}
+
+func TestAfforyWindowsExactPathIgnoresCase(t *testing.T) {
+	r := NewProcessPathItem([]string{`C:\Apps\app.exe`})
+	if !r.Match(&adapter.InboundContext{ProcessInfo: &adapter.ConnectionOwner{ProcessPath: `c:\APPS\App.EXE`}}) {
+		t.Fatal("Windows executable casing changed its route")
+	}
+	if r.Match(&adapter.InboundContext{ProcessInfo: &adapter.ConnectionOwner{ProcessPath: `C:\Other\app.exe`}}) {
+		t.Fatal("filename alone matched")
+	}
+}
+
+func TestAfforyRootsOptionIsAccepted(t *testing.T) {
+	var r option.Rule
+	if err := r.UnmarshalJSONContext(context.Background(), []byte(`{"process_path_tree":["C:\\Outer.exe"],"process_path_tree_roots":["C:\\Outer.exe","C:\\Inner.exe"],"outbound":"direct"}`)); err != nil {
+		t.Fatal(err)
+	}
+	if len(r.DefaultOptions.ProcessPathTreeRoots) != 2 {
+		t.Fatal("roots were dropped")
+	}
+}
