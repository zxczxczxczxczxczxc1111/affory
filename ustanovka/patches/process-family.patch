diff --git a/route/rule/rule_item_process_tree.go b/route/rule/rule_item_process_tree.go
new file mode 100644
index 0000000..0857d3a
--- /dev/null
+++ b/route/rule/rule_item_process_tree.go
@@ -0,0 +1,33 @@
+package rule
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	"strings"
+)
+
+type ProcessPathTreeItem struct {
+	paths       map[string]bool
+	description string
+}
+
+func NewProcessPathTreeItem(paths []string) *ProcessPathTreeItem {
+	r := &ProcessPathTreeItem{paths: make(map[string]bool), description: "process_path_tree=" + strings.Join(paths, ",")}
+	for _, path := range paths {
+		r.paths[strings.ToLower(path)] = true
+	}
+	return r
+}
+
+func (r *ProcessPathTreeItem) Match(metadata *adapter.InboundContext) bool {
+	if metadata.ProcessInfo == nil {
+		return false
+	}
+	for _, path := range metadata.ProcessInfo.ProcessFamilyPaths {
+		if r.paths[strings.ToLower(path)] {
+			return true
+		}
+	}
+	return false
+}
+
+func (r *ProcessPathTreeItem) String() string { return r.description }
diff --git a/route/rule/rule_item_process_tree_test.go b/route/rule/rule_item_process_tree_test.go
new file mode 100644
index 0000000..b000059
--- /dev/null
+++ b/route/rule/rule_item_process_tree_test.go
@@ -0,0 +1,32 @@
+package rule
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"testing"
+)
+
+func TestAfforyProcessFamilyMatchesAncestryNotExecutableName(t *testing.T) {
+	r := NewProcessPathTreeItem([]string{`C:\Steam\steam.exe`})
+	inside := &adapter.InboundContext{ProcessInfo: &adapter.ConnectionOwner{
+		ProcessID: 20, ProcessPath: `C:\helper.exe`, ProcessFamilyPaths: []string{`C:\helper.exe`, `c:\steam\STEAM.exe`},
+	}}
+	outside := &adapter.InboundContext{ProcessInfo: &adapter.ConnectionOwner{
+		ProcessID: 30, ProcessPath: `C:\helper.exe`, ProcessFamilyPaths: []string{`C:\helper.exe`, `C:\explorer.exe`},
+	}}
+	if !r.Match(inside) || r.Match(outside) || r.Match(&adapter.InboundContext{}) {
+		t.Fatal("process family classification is incorrect")
+	}
+}
+
+func TestAfforyProcessFamilyOptionIsAccepted(t *testing.T) {
+	var rule option.Rule
+	err := rule.UnmarshalJSONContext(context.Background(), []byte(`{"process_path_tree":["C:\\Steam\\steam.exe"],"outbound":"direct"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rule.DefaultOptions.ProcessPathTree) != 1 {
+		t.Fatal("family matcher was discarded")
+	}
+}
